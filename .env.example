# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Used by docker-compose for published app port (optional)
APP_HOST_PORT=4010

# -----------------------------------------------------------------------------
# Auth (JWT)
# -----------------------------------------------------------------------------
# Min 32 characters in production
JWT_SECRET=
JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Optional: overrides composed URL from POSTGRES_* below
DATABASE_URL=
POSTGRES_DB=healthcare_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=redis
REDIS_PORT=6379
REDIS_HOST=localhost
# Optional: full URL; otherwise built from REDIS_* above
REDIS_URL=

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads

# AWS S3 (file uploads / signed URLs for messages)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Regional endpoint from AWS error, or MinIO e.g. http://localhost:9000
AWS_S3_ENDPOINT=
# true / yes / 1 for MinIO or path-style S3-compatible APIs
AWS_S3_FORCE_PATH_STYLE=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_SIGNED_URL_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Client / CORS
# -----------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Optional: dedicated key for message body encryption (falls back to JWT_SECRET)
MESSAGE_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# AI — transcription & translation
# -----------------------------------------------------------------------------
# OpenAI-compatible Bearer token for Whisper (POST OPENAI_TRANSCRIPTION_URL)
TRANSCRIBE_API_KEY=
# OpenAI-compatible Bearer token for chat-completions translation when TRANSLATION_PROVIDER=openai
TRANSLATION_API_KEY=
OPENAI_TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
OPENAI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

TRANSLATION_PROVIDER=openai
# Used when TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-2.0-flash


