generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  AGENT
  ADMIN
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")
  users         User[]
  conversations Conversation[]
  messages      Message[]
  pushTokens    UserPushToken[]

  @@map("tenants")
}

model User {
  id                       String                    @id @default(uuid())
  tenantId                 String                    @map("tenant_id")
  role                     Role
  username                 String
  email                    String
  passwordHash             String                    @map("password_hash")
  createdAt                DateTime                  @default(now()) @map("created_at")
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]                 @relation("message_sender")
  reactions                MessageReaction[]
  deliveredReceipts        DeliveryReceipt[]
  readReceipts             ReadReceipt[]
  pushTokens               UserPushToken[]

  @@unique([tenantId, email])
  @@unique([username])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([username])
  @@index([email])
  @@map("users")
}

model UserPushToken {
  id         String         @id @default(uuid())
  tenantId   String         @map("tenant_id")
  userId     String         @map("user_id")
  token      String
  platform   DevicePlatform
  deviceId   String?        @map("device_id")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([token])
  @@index([tenantId, userId])
  @@map("user_push_tokens")
}

model Conversation {
  id              String                    @id @default(uuid())
  tenantId        String                    @map("tenant_id")
  isGlobal        Boolean                   @default(false) @map("is_global")
  createdAt       DateTime                  @default(now()) @map("created_at")
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants    ConversationParticipant[]
  messages        Message[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, isGlobal])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id           String            @id @default(uuid())
  conversationId String          @map("conversation_id")
  tenantId     String            @map("tenant_id")
  senderId     String            @map("sender_id")
  type         MessageType
  content      String
  deletedAt    DateTime?         @map("deleted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  conversation Conversation      @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender       User              @relation("message_sender", fields: [senderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  reactions    MessageReaction[]
  deliveredReceipts DeliveryReceipt[]
  readReceipts ReadReceipt[]

  @@index([tenantId, conversationId, createdAt])
  @@index([senderId])
  @@index([deletedAt])
  @@map("messages")
}

model MessageReaction {
  id           String   @id @default(uuid())
  messageId    String   @map("message_id")
  userId       String   @map("user_id")
  reactionType String   @map("reaction_type")
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_reactions")
}

model ReadReceipt {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  readAt    DateTime @map("read_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("read_receipts")
}

model DeliveryReceipt {
  id          String   @id @default(uuid())
  messageId   String   @map("message_id")
  userId      String   @map("user_id")
  deliveredAt DateTime @map("delivered_at")
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("delivery_receipts")
}
